# Nilai di bawah untuk pengembangan lokal. Untuk PRODUKSI, ubah baris bertanda [PRODUKSI].
APP_NAME=Supermaterial
# [PRODUKSI] production
APP_ENV=local
APP_KEY=
# [PRODUKSI] false (wajib: true menampilkan detail galat dan konfigurasi ke publik)
APP_DEBUG=true
# [PRODUKSI] https://domain-anda (dipakai sitemap, canonical, dan tautan di email antrean)
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# [PRODUKSI] daily agar log tidak membengkak
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# [PRODUKSI] warning
LOG_LEVEL=debug

# HTTPS di balik proxy/CDN/load balancer (Cloudflare, Nginx proxy, LB hosting).
# [PRODUKSI] "*" bila server hanya bisa diakses lewat proxy tepercaya, atau daftar IP proxy dipisah koma. Kosongkan bila TLS langsung di server ini.
TRUSTED_PROXIES=
# Di APP_ENV=production: semua URL https dan request http dialihkan 301 ke https
FORCE_HTTPS=true

# [PRODUKSI] mysql atau pgsql disarankan; SQLite kurang cocok untuk banyak penulisan bersamaan (sesi, cache, antrean)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# [PRODUKSI] redis disarankan untuk sesi & cache bila tersedia
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kosong = otomatis aktif bila APP_ENV=production (cookie sesi hanya lewat HTTPS)
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Wajib ada worker: php artisan queue:work (notifikasi formulir, impor produk)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# [PRODUKSI] smtp (atau layanan email lain) dengan kredensial asli; "log" hanya menulis email ke file log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# [PRODUKSI] alamat pengirim di domain Anda, mis. "noreply@domain-anda"
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keamanan login panel: setelah sekian gagal, login wajib lewat tautan email
SECURITY_LOGIN_MAX_FAILURES_EMAIL=5
SECURITY_LOGIN_MAX_FAILURES_CLIENT=10
SECURITY_CSP_ENABLED=true

# REST API v1 (PRD 8.12)
API_CORS_ORIGINS=
API_RATE_LIMIT_PUBLIC=60
API_RATE_LIMIT_ADMIN=120
API_CACHE_TTL=300
API_CACHE_MAX_AGE=60
API_TOKEN_EXPIRATION_DAYS=90
