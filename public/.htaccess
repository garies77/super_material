<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Tandai aset bernama hash untuk cache jangka panjang (lihat mod_headers di bawah)
    RewriteRule ^(build/assets|storage/derivatives)/ - [E=IMMUTABLE:1]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Kompresi teks (HTML, CSS, JS, SVG, JSON) agar unduhan di jaringan seluler lebih kecil
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# Cache browser untuk berkas statis. Halaman HTML (lewat index.php) tidak terpengaruh.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|jpe?g|png|gif|webp|avif|svg|ico|woff2?)$">
        # Gambar unggahan, font, ikon, dan aset berversi: 7 hari (nama berkas unggahan bisa dipakai ulang saat diganti)
        Header set Cache-Control "public, max-age=604800"
        # Aset Vite dan turunan gambar bernama hash (ditandai IMMUTABLE di atas): isi pada satu URL tidak pernah berubah
        Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
    </FilesMatch>
</IfModule>
